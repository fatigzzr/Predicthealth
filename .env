# PredictHealth .env example (copy to .env and edit as needed)

# --- Database (used by most services via services/shared/db.py) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=predicthealth
DB_USER=predicthealth_user
DB_PASSWORD=change-me

# Optional: Full URL (used by register_service)
# If set, register_service will prefer this over DB_* variables.
DATABASE_URL=postgresql://predicthealth_user:change-me@localhost/predicthealth

# --- Redis (used for JWT allowlist/cache) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- JWT settings (used by auth_service and shared/auth.py) ---
# IMPORTANT: Change JWT_SECRET to a long random value in production
JWT_SECRET=c2VjdXJlX3JhbmRvbV9rZXlfZm9yX3dlayE=
JWT_ALG=HS256
JWT_AUD=predicthealth
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=7

# --- Service ports ---
# Only services reading env for port are listed here.
AUTH_PORT=8001
REGISTER_PORT=8002
PACIENTE_PORT=8003
HEALTH_PORT=8004
DATA_SERVICE_PORT=8010
RECOMMENDATIONS_SERVICE_PORT=8011
# Note: Diabetes (8008) and Hypertension (8009) currently use fixed ports in code.

# --- Hypertension scaling knobs (optional; service has sensible defaults) ---
HYPERTENSION_SCALE=thresholded
HYPERTENSION_THRESHOLD=0.8
HYPERTENSION_GAMMA=12

# --- CORS (not currently env-driven; kept here for future) ---
# ALLOW_ORIGINS=*

